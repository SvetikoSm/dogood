# Публичный URL сайта (операции / ссылки)
# NEXT_PUBLIC_SITE_URL=https://ваш-домен.ru

# Заказы → Google Таблица + Диск (см. scripts/google-apps-script-order-webapp.gs)
# GOOGLE_ORDER_WEBHOOK_URL=
# GOOGLE_ORDER_WEBHOOK_SECRET=

# Операции / Google Sheets (если пользуетесь админ-инструментами)
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Internal Studio (/studio) — multi-stage design pipeline ---
# STUDIO_ADMIN_PASSWORD=
# STUDIO_SESSION_SECRET=
# STUDIO_DATABASE_URL=file:./data/studio/studio.db
# STUDIO_DATA_DIR=data/studio
# STUDIO_MOCK_AI=true
# OPENROUTER_API_KEY=
# LLM: use your OpenRouter slug (e.g. Gemini “Flash Lite” preview).
# STUDIO_LLM_MODEL=google/gemini-2.5-flash-preview-05-20
# Image: “Nano Banana” / Gemini image — set OpenRouter slug OR use STUDIO_IMAGE_HTTP_URL.
# STUDIO_IMAGE_MODEL=
# STUDIO_IMAGE_HTTP_URL=
# STUDIO_SHEET_PET_NAME_COLUMN=
