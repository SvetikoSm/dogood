# Публичный URL сайта (Timeweb / VPS)
# NEXT_PUBLIC_SITE_URL=https://dogood-brand.ru
# OPS_PUBLIC_BASE_URL=https://dogood-brand.ru

# Яндекс.Метрика (счётчик + цель order_submit на форме заказа)
# NEXT_PUBLIC_YM_COUNTER_ID=110047642

# Safari iOS: одноразовый сброс кэша (менять при деплое; см. middleware.ts)
# CACHE_BUST_ID=20250627-safari

# Заказы → Google Таблица + Диск (см. scripts/google-apps-script-order-webapp.gs)
# GOOGLE_ORDER_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# GOOGLE_ORDER_WEBHOOK_SECRET=тот_же_что_WEBHOOK_SECRET_в_Apps_Script

# Резерв: если GAS не кладёт фото (fileCount=0), сервер грузит через Drive API
# GOOGLE_ORDER_DRIVE_FOLDER_ID=   # = FOLDER_ID в Apps Script; папку расшарить на client_email SA
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   # одна строка, без переносов

# Операции / Google Sheets + пинг после заказа (опционально)
# GOOGLE_SHEETS_SPREADSHEET_ID=1v0qR8kUcEICstHSo-R1yluzxarepLmL2B_cSTd1KN1Y
# GOOGLE_SHEETS_TAB_NAME=DOGOOD
# STUDIO_SHEET_PET_NAME_COLUMN=Кличка
# OPS_WEBHOOK_SECRET=   # = NEXT_OPS_PING_SECRET в Apps Script
# В Apps Script: NEXT_OPS_PING_URL=https://dogood-brand.ru/api/ops/webhooks/order-event

# --- Internal Studio (/studio) — automated pipeline (replaces n8n) ---
# STUDIO_ADMIN_PASSWORD=
# STUDIO_SESSION_SECRET=
# STUDIO_CRON_SECRET=          # Bearer for GET /api/studio/cron/tick
# STUDIO_DATABASE_URL=file:./data/studio/studio.db
# STUDIO_DATA_DIR=data/studio
# STUDIO_MOCK_AI=false
# OPENROUTER_API_KEY=          # same key as n8n OpenRouter credential
# STUDIO_LLM_MODEL=google/gemini-2.5-flash-preview-05-20
# STUDIO_IMAGE_MODEL=google/gemini-3-pro-image-preview
# STUDIO_IMAGE_HTTP_URL=
# Google Drive folders (defaults match n8n + user layout; override if needed):
# STUDIO_DRIVE_APPROVED_FOLDER_ID=1-n0MWLhsxWG6_Rz9GMCp4LG9xYd2oiaQ
# STUDIO_DRIVE_MOCKUP_FOLDER_ID=1cqXzHfe1xByc1aFOlCZLbAGXyH-gISJ0
# STUDIO_DRIVE_PET_REFS_FOLDER_ID=1VcahlOwbGHCqK8iK3HULf4wENu2mTefq
# STUDIO_DRIVE_TEXT_REFS_FOLDER_ID=17K50Hx83nj4OBGgMLjM_8Qqzio1VXNqu
# STUDIO_DRIVE_TEXT_BADGES_FOLDER_ID=1eB9OI-KYKFb3s4LdiVBEnVOTwxSZGjtl
# Telegram review bot:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=
# OPS_NOTIFY_TELEGRAM=true
# Cron: curl -H "Authorization: Bearer $STUDIO_CRON_SECRET" https://dogood-brand.ru/api/studio/cron/tick
# Sync Drive templates once: curl -X POST -H "Authorization: Bearer $STUDIO_CRON_SECRET" https://dogood-brand.ru/api/studio/templates/sync-drive

# n8n API (для настройки workflow через агента / scripts/test-n8n-api.ps1)
# Cloud: https://ВАШ-ПОДДОМЕН.app.n8n.cloud/api/v1
# Self-hosted: https://ваш-домен/api/v1  (или http://localhost:5678/api/v1)
# N8N_API_URL=
# N8N_API_KEY=
